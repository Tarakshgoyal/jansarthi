ENVIRONMENT=production
DEBUG=false
DEV_MODE=false
CORS_ORIGINS=https://jansarthi.shubhang.dev

DATABASE_URL=postgresql://USER:PASSWORD@HOST/jansarthi?sslmode=require&channel_binding=require
MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@DIRECT_HOST/jansarthi?sslmode=require&channel_binding=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

S3_ENDPOINT=ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY=REPLACE_ME
S3_SECRET_KEY=REPLACE_ME
S3_BUCKET=jansarthi-shubhang-prod
S3_REGION=auto
S3_SECURE=true
PRESIGNED_URL_EXPIRY_SECONDS=3600

JWT_SECRET_KEY=REPLACE_ME
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

OTP_SERVICE_API_KEY=REPLACE_ME
OTP_EXPIRY_MINUTES=10
OTP_REQUEST_COOLDOWN_SECONDS=60
OTP_HTTP_TIMEOUT_SECONDS=10
